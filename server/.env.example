# Copy this file to ".env" in the same folder and fill in real values.

# Server
PORT=5000

# MongoDB connection string.
# Local:   mongodb://127.0.0.1:27017/tripshare_india
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tripshare_india
MONGO_URI=mongodb://127.0.0.1:27017/tripshare_india

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Admin seed account (used by "npm run seed")
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@tripshare.in
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=9999999999
ADMIN_CITY=Delhi

# Frontend origin allowed by CORS.
# Locally (client/index.html opened via Live Server): http://127.0.0.1:5500
# On Render: the client is served by this SAME Express app (see server.js),
# so cross-origin requests aren't used in production and "*" is safe to leave.
CLIENT_ORIGIN=*
